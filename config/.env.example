# EduIG-Pipeline Environment Variables Template
# Copy this to .env and configure as needed.

# Application Environment (development, production)
EDUIG_ENV=development

# Optional: Override configuration settings using double underscores
# Format: EDUIG_<SECTION>__<SETTING_NAME>=value
# Examples:
# EDUIG_RATE_LIMIT__REQUESTS_PER_HOUR=10
# EDUIG_COMPLIANCE__REQUIRE_CONSENT=true
# EDUIG_LOGGING__LEVEL=DEBUG

# --- Authentication & Scraper Configuration ---
# Instagram Account Credentials (PRIMARY)
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password
INSTAGRAM_TOTP_SECRET=your_totp_secret
INSTAGRAM_BACKUP_CODES=code1,code2,code3

# Secondary Account (Backup)
INSTAGRAM_BACKUP_USERNAME=backup_username
INSTAGRAM_BACKUP_PASSWORD=backup_password

# Session Encryption (Run `python scripts/generate_encryption_key.py` to get this)
SESSION_ENCRYPTION_KEY=your_fernet_key_here
